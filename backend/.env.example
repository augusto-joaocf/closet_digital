NODE_ENV=development
HOST=127.0.0.1
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=closet_digital
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
# Caminho para o certificado CA quando exigido pelo provedor. Nunca desativamos a verificação TLS.
DB_SSL_CA_PATH=

# Gere dois segredos DIFERENTES com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=5m
# Segredo HMAC para os hashes dos refresh tokens OPACOS; refresh não é um segundo JWT.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=closet-digital-api
JWT_AUDIENCE=closet-digital-client
BCRYPT_ROUNDS=12

FRONTEND_URL=http://localhost:5173
# Origens exatas separadas por vírgula, sem barra final; inclua FRONTEND_URL.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_NAME=closet_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Não use true ou número de saltos. Se necessário, informe os IPs/CIDRs exatos do proxy.
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
