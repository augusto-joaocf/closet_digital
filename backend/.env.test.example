# Copie para .env.test somente para um banco separado de testes. Nenhum teste usa .env.
# Mantenha 0 até fornecer credenciais de um usuário limitado exclusivamente a esse banco.
RUN_MYSQL_TESTS=0
NODE_ENV=test
HOST=127.0.0.1
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=closet_digital_test
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false
DB_SSL_CA_PATH=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=4
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=100
API_RATE_LIMIT_MAX=1000
